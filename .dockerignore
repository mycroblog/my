# Keep the build context to what the Dockerfile reads.
*
!go.mod
!go.sum
!cmd/
!internal/
# The Dockerfile mounts web/brand over this directory; a local build stays out.
internal/interface/web/dist/*
!internal/interface/web/dist/.gitkeep
!pkg/
# The Go package that embeds the bundled OpenAPI document (internal/interface/clientapi serves it).
!api/api.go
!api/openapi.yaml
pkg/*/ts/node_modules
pkg/*/ts/dist
!locales/
!web/brand/
!schema/
!scripts/install-atlas.sh
!scripts/check-release-build.sh
# The pointers for coding agents: no build reads them, so a change to one keeps the layers.
**/AGENTS.md
