# Keep the build context to what the Dockerfile reads.
*
!go.mod
!go.sum
!cmd/
!internal/
# The stage web builds this directory; a local build stays out.
internal/interface/web/dist/*
!internal/interface/web/dist/.gitkeep
!pkg/
# The Go package that embeds the bundled OpenAPI document (internal/interface/clientapi serves it).
!api/api.go
!api/openapi.yaml
!locales/
!schema/
!scripts/install-atlas.sh
!scripts/check-release-build.sh
# The web client's build (the stage web): go-task, the Bun workspace, and its members. Of web/docs, which the build
# does not read, only the manifest that the lockfile names.
!scripts/task.sh
!tools/go.mod
!tools/go.sum
!Taskfile.yml
!tasks/
!package.json
!bun.lock
!bunfig.toml
!tsconfig.base.json
!tools/i18n/
!web/
web/docs/
!web/docs/package.json
# What the stage installs or generates itself.
**/node_modules
**/dist
web/*/src/messages.gen.ts
web/app/src/routeTree.gen.ts
!internal/interface/web/dist/.gitkeep
# The pointers for coding agents: no build reads them, so a change to one keeps the layers.
**/AGENTS.md
