# Keep the build context to what the Dockerfile reads.
*
!go.mod
!go.sum
!cmd/
!internal/
# The Dockerfile mounts the web build it makes over this directory; a local build stays out.
internal/interface/web/dist/*
!internal/interface/web/dist/.gitkeep
!pkg/
# The Go package that embeds the bundled OpenAPI document (internal/interface/clientapi serves it).
!api/api.go
!api/openapi.yaml
!locales/
!app/
app/**/node_modules
app/**/dist
pkg/mykit/ts/node_modules
pkg/mykit/ts/dist
!tools/i18n/
tools/i18n/node_modules
# The generated files that are not committed (ADR-0081): the web stage generates its own.
locales/en-XA/client*
locales/ar-XB/client*
tools/i18n/src/runtime/messages.gen.ts
app/web/src/routeTree.gen.ts
app/ui/src/themeTokens.gen.ts
!schema/
!scripts/install-atlas.sh
!scripts/check-release-build.sh
