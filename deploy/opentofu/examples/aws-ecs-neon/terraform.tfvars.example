# SPDX-License-Identifier: AGPL-3.0-only
#
# Copy to terraform.tfvars. Nothing here has been applied: read deploy/opentofu/modules/app-aws-ecs/README.md.

host            = "social.example.org"
certificate_arn = "arn:aws:acm:ap-northeast-1:111122223333:certificate/00000000-0000-0000-0000-000000000000"
bucket_name     = "social-example-org-media"

availability_zones = ["ap-northeast-1a", "ap-northeast-1c"]

# true for a public subnet: each task has a public IPv4 address, billed by the hour. false for a private subnet, with a NAT
# gateway that the network then creates, billed by the hour and by the GB. Inbound traffic reaches a task only through the load balancer either way.
assign_public_ip = true

# Recommended: a public hosted zone of host in Route 53, where the records work at a zone apex too.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"
#
# Otherwise, whether host is the apex of its zone, where a plain CNAME cannot be used. tofu output dns_records says what to create.
# host_is_apex = true

mail_from          = "noreply@social.example.org"
mail_smtp_host     = "smtp.example.org"
mail_smtp_username = "my-smtp-user"
