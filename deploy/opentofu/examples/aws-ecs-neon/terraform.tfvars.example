# SPDX-License-Identifier: AGPL-3.0-only
#
# Copy to terraform.tfvars. Nothing on AWS has been applied: read "AWS" in deploy/opentofu/README.md. The module names the
# secrets; tofu output secrets_to_fill lists what to add after the first apply.

host            = "social.example.org"
certificate_arn = "arn:aws:acm:ap-northeast-1:111122223333:certificate/00000000-0000-0000-0000-000000000000"
bucket_name     = "social-example-org-media"

availability_zones = ["ap-northeast-1a", "ap-northeast-1c"]

# public-ip for a public subnet: each task has a public IPv4 address, billed by the hour. nat for a private subnet, with a NAT
# gateway that the network then creates, billed by the hour and by the GB. Inbound traffic reaches a task only through the load
# balancer either way.
egress = "public-ip"

# Recommended: a public hosted zone of host in Route 53, where the records work at a zone apex too. Otherwise tofu output
# dns_records says what to create.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# SES sends from the domain of this address once the records of dns_records are in place.
mail_from    = "noreply@social.example.org"
alert_emails = ["ops@social.example.org"]
