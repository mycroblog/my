#
# Copy to terraform.tfvars. Nothing here has been applied: read deploy/opentofu/modules/app-aws-lambda/README.md.

host            = "social.example.org"
image           = "111122223333.dkr.ecr.ap-northeast-1.amazonaws.com/my:0.1.0"
certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/00000000-0000-0000-0000-000000000000"
bucket_name     = "social-example-org-media"

# Recommended: a public hosted zone of host in Route 53, where the records work at a zone apex too.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"
#
# Otherwise, whether host is the apex of its zone, where a plain CNAME cannot be used. tofu output dns_records says what to create.
# host_is_apex = true

mail_from          = "noreply@social.example.org"
mail_smtp_host     = "smtp.example.org"
mail_smtp_username = "my-smtp-user"
