# TLS front of the live interoperability stack (compose.yaml): one certificate of the private CA for every host,
# forwarded by host name. The Host header passes through unchanged, so HTTP signatures that cover it verify.

{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

(site) {
	tls /certs/server.pem /certs/server.key
	log {
		output stdout
		format json
	}
}

https://my.test {
	import site
	# The signature scenario (TestSignatureProfile): a draft-cavage POST signed by eve@mastodon.test
	# (FEDERATION_LIVE_SIGNER_ACTOR, compose.yaml) is refused with 401, so Mastodon resends it with
	# RFC 9421 (ADR-0032) and this server verifies that.
	@cavage_from_eve {
		method POST
		header Signature `*keyId="{$FEDERATION_LIVE_SIGNER_ACTOR}#*`
		not header Signature-Input *
	}
	respond @cavage_from_eve 401
	reverse_proxy my:8080
}

https://mastodon.test {
	import site
	# The signature scenario: a draft-cavage POST to eve's inbox (FEDERATION_LIVE_SIGNER_INBOX) is
	# refused with 401, so this server resends it with RFC 9421, double-knocking (ADR-0032), and
	# Mastodon verifies that.
	@cavage_to_eve {
		method POST
		path {$FEDERATION_LIVE_SIGNER_INBOX}
		not header Signature-Input *
	}
	respond @cavage_to_eve 401
	reverse_proxy mastodon-web:3000
}

https://gts.test {
	import site
	reverse_proxy gotosocial:8080
}

https://misskey.test {
	import site
	reverse_proxy misskey:3000
}

https://akkoma.test {
	import site
	reverse_proxy akkoma:4000
}

https://relay.test {
	import site
	reverse_proxy relay-server:8080
}
