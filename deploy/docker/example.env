# SPDX-License-Identifier: AGPL-3.0-only
#
# The template of the settings of the Docker Compose deployment. Copy it to .env (which Git ignores) in this directory:
#
#   cp example.env .env
#   mkdir -m 700 secrets
#   (umask 022; openssl rand -base64 32 > secrets/kek)
#
# Back up secrets/kek apart from the database: without it the data cannot be decrypted.
#
# Compose reads .env twice: to fill in the ${...} of the compose files, and, through env_file, to hand every line to the
# containers of the server as environment variables. So every setting below works by being set here, and:
#
# - The key-encryption key is not in this file. A line MY_KEK=... would reach the containers as an environment variable,
#   so the key lives in the file secrets/kek and reaches them as the Docker secret /run/secrets/my_kek (MY_KEK_FILE). The
#   server runs as the user 65532, so the file must be readable by others: the directory's mode 700 protects it. If this
#   file sets MY_KEK anyway, the server refuses to start, since it takes only one of the two.
# - Other secrets (the database URL, API keys) are passed as environment variables. To keep one out of them too, mount a
#   file and set its NAME_FILE in compose.override.yaml, as compose.yaml does for the KEK. Keep this file private:
#   chmod 600 .env.
# - Lines are taken literally except for $: write a value with a $ in single quotes.
# - The lines of a setting that is commented out show its default where it has one. Uncomment what you change.
#
# The settings are described in full in docs/reference/configuration.md.

# ------------------------------------------------------------------------------------------------------------------
# Compose itself. The server does not read these.
# ------------------------------------------------------------------------------------------------------------------

# The version of the image: 0.1.0 (for good), 0.1 (the latest patch of v0.1, on the next docker compose pull), or
# 0.1.0@sha256:... (the digest in the release's notes). There is no latest.
MY_VERSION=

# The port of the server on the loopback address of this machine.
# MY_HTTP_PORT=8080

# The layers, so that every docker compose command takes them without -f options (: is ; on Windows). Any of
# compose.postgres.yaml, compose.s3.yaml, and compose.caddy.yaml; see the header of each.
# COMPOSE_FILE=compose.yaml:compose.postgres.yaml:compose.s3.yaml:compose.caddy.yaml

# compose.postgres.yaml: the password of the database, letters and digits only (openssl rand -hex 32).
# POSTGRES_PASSWORD=

# compose.s3.yaml with the bundled Garage: the profile, and two secrets of Garage (each from openssl rand -hex 32). Under
# "Media storage" below, also set these settings:
#
#   MY_BLOB_S3_ENDPOINT=http://garage:3900
#   MY_BLOB_S3_BUCKET=my-media
#   MY_BLOB_S3_PATH_STYLE=true
#   MY_BLOB_S3_ACCESS_KEY_ID=      the output of: echo "GK$(openssl rand -hex 12)"
#   MY_BLOB_S3_SECRET_ACCESS_KEY=  the output of: openssl rand -hex 32
#
# COMPOSE_PROFILES=garage
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=

# ------------------------------------------------------------------------------------------------------------------
# The instance
# ------------------------------------------------------------------------------------------------------------------

# Domain that serves the instance. Required: yes.
MY_HOST=localhost:8080

# Domain of user handles (`@alice@{account_domain}`). Default: value of `host`.
# MY_ACCOUNT_DOMAIN=

# Where users get the source code of the running server, as an `https` URL or a `mailto:` address to request it from.
# MY_SOURCE_URL=https://github.com/mycroblog/my

# Address of the instance's status page, an absolute `https` URL on a service apart from the server.
# MY_STATUS_PAGE_URL=

# ------------------------------------------------------------------------------------------------------------------
# Maintenance mode
# ------------------------------------------------------------------------------------------------------------------

# Starts `my serve` in the maintenance mode, also set by `my serve -maintenance`. Values: false, true.
# MY_MAINTENANCE=false

# Name of the server on the maintenance page and the exported maintenance pages (`my maintenance export`). Default:
# value of `host`.
# MY_MAINTENANCE_SERVER_NAME=

# Notice of the maintenance as plain text, at most 2,000 characters, shown on the maintenance page and in the
# `message` of the maintenance problem of the client API.
# MY_MAINTENANCE_MESSAGE=

# When the maintenance is expected to end, as an RFC 3339 time such as `2026-10-24T03:00:00Z`.
# MY_MAINTENANCE_UNTIL=

# The `Retry-After` of the maintenance responses when `maintenance_until` is unset or past, a Go duration from `1s` to
# `24h`.
# MY_MAINTENANCE_RETRY_AFTER=10m

# ------------------------------------------------------------------------------------------------------------------
# Origins
# ------------------------------------------------------------------------------------------------------------------

# Origin (`scheme://host[:port]`) of the web client. Default: `https://{host}`.
MY_WEB_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------------------------------------------
# Processes
# ------------------------------------------------------------------------------------------------------------------

# What this process runs. Values: all, web, worker.
# MY_ROLE=all

# Comma-separated job types that this process runs, each a name such as `federation.deliver` or a prefix such as
# `federation.*`; the others wait for another worker.
# MY_WORKER_JOB_TYPES=

# Comma-separated job types that this process does not run, written like `worker_job_types`.
# MY_WORKER_JOB_TYPES_EXCEPT=

# How many jobs this process runs at once, from 1 to 128. Default: `1`.
# MY_WORKER_JOB_CONCURRENCY=

# ------------------------------------------------------------------------------------------------------------------
# HTTP server
# ------------------------------------------------------------------------------------------------------------------

# TCP address the HTTP server listens on, as `host:port`.
# MY_LISTEN=:8080

# Reverse proxies and load balancers in front of the server whose forwarding header (`trusted_proxy_header`) tells the
# client IP, as comma-separated CIDRs or addresses such as `10.0.0.0/8, 2001:db8::/32, 192.0.2.10`.
# MY_TRUSTED_PROXIES=

# Forwarding header that the `trusted_proxies` append the client IP to. Values: x-forwarded-for, forwarded.
# MY_TRUSTED_PROXY_HEADER=x-forwarded-for

# Refuses the requests that did not come through your CDN. A secret.
# MY_ORIGIN_SECRET=

# A second value that the check accepts while you rotate `origin_secret`, in the same format, since the CDN and the
# server cannot change at the same moment. A secret.
# MY_ORIGIN_SECRET_PREVIOUS=

# Name of the request header that carries `origin_secret`, which the server removes before anything else reads the
# request. Required: when `origin_secret` is set.
# MY_ORIGIN_SECRET_HEADER=

# ------------------------------------------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------------------------------------------

# Database adapter. Values: sqlite, postgres.
# MY_DATABASE=sqlite

# Connection string passed to the `database` adapter, in that adapter's format. Required: yes. A secret.
# MY_DATABASE_URL=/data/my.db

# How long a request or a job waits for a free connection of the database's pool before giving up, as a Go duration;
# `0` waits without a limit. Default: `60s`.
# MY_DATABASE_ACQUIRE_TIMEOUT=

# Connection string of the dev database that `my schema apply` builds the desired schema in, for `database =
# postgres`, in the format of `database_url`. Default: a temporary schema in the database of `database_url`. A secret.
# MY_DATABASE_DEV_URL=

# ------------------------------------------------------------------------------------------------------------------
# Job queue
# ------------------------------------------------------------------------------------------------------------------

# Job queue adapter. Values: db, inline, cloudtasks.
# MY_QUEUE=db

# Comma-separated routes of `queue = cloudtasks`, each `type=queue resource name` with an optional `@receiver URL`,
# that send the wake-up signals of those job types to their own queue, and to a separate service when the URL is given
# (`queue_cloudtasks_url` otherwise).
# MY_QUEUE_CLOUDTASKS_ROUTES=

# Resource name of the Cloud Tasks queue of `queue = cloudtasks`,
# `projects/{project}/locations/{location}/queues/{queue}`, which the deployment template creates. Required: when
# `queue = cloudtasks`.
# MY_QUEUE_CLOUDTASKS_QUEUE=

# Absolute `https` URL of the server that Cloud Tasks and Cloud Scheduler call with `queue = cloudtasks`, without a
# path. Default: `https://{host}`.
# MY_QUEUE_CLOUDTASKS_URL=

# Email of the service account whose OIDC ID token each task of `queue = cloudtasks` carries, and that the Cloud
# Scheduler job of the tick uses too. Required: when `queue = cloudtasks`.
# MY_QUEUE_CLOUDTASKS_SERVICE_ACCOUNT=

# Audience of the OIDC ID tokens of `queue = cloudtasks`, which the tasks ask for and the endpoints require. Default:
# the URL of the endpoint called.
# MY_QUEUE_CLOUDTASKS_AUDIENCE=

# How long Cloud Tasks waits for one delivery of `queue = cloudtasks` to answer, from `15s` to `30m`. Default: `10m`.
# MY_QUEUE_CLOUDTASKS_DISPATCH_DEADLINE=

# ------------------------------------------------------------------------------------------------------------------
# Media storage
# ------------------------------------------------------------------------------------------------------------------

# Blob storage adapter for media. Values: fs, s3, gcs.
# MY_BLOB=fs

# Processor of images. Values: native, plugin.
# MY_MEDIA_IMAGE=native

# Processor of videos. Values: native, plugin.
# MY_MEDIA_VIDEO=native

# Processor of audio-only files. Values: native, plugin.
# MY_MEDIA_AUDIO=native

# Directory of the `fs` blob store, relative to the working directory or absolute.
# MY_BLOB_FS_DIR=/data/blobs

# Bucket of the `s3` blob store. Required: when `blob = s3`.
# MY_BLOB_S3_BUCKET=

# Origin of the S3-compatible API of `blob = s3`, such as `https://<account>.r2.cloudflarestorage.com` (Cloudflare
# R2), `https://storage.googleapis.com` (Google Cloud Storage with an HMAC key), or `http://minio:9000`.
# MY_BLOB_S3_ENDPOINT=

# Region of the bucket of `blob = s3`, such as `eu-west-1`; `auto` for Cloudflare R2 and Google Cloud Storage.
# MY_BLOB_S3_REGION=

# How `blob = s3` addresses the bucket. Values: false, true.
# MY_BLOB_S3_PATH_STYLE=false

# Access key ID of `blob = s3`, with `blob_s3_secret_access_key`.
# MY_BLOB_S3_ACCESS_KEY_ID=

# Secret access key of `blob_s3_access_key_id`. Required: when `blob_s3_access_key_id` is set. A secret.
# MY_BLOB_S3_SECRET_ACCESS_KEY=

# Bucket of the `gcs` blob store. Required: when `blob = gcs`.
# MY_BLOB_GCS_BUCKET=

# ------------------------------------------------------------------------------------------------------------------
# Media
# ------------------------------------------------------------------------------------------------------------------

# Origin (`scheme://host[:port]`, no path) at which the media files are served, for a CDN in front of the server's
# `/media/`. Default: the server's own origin (`https://{host}`).
# MY_MEDIA_ORIGIN=

# Largest accepted image upload in bytes.
# MY_MEDIA_MAX_IMAGE_BYTES=16777216

# Largest accepted image width and height in pixels, read from the file's header before decoding.
# MY_MEDIA_MAX_IMAGE_SIDE=8192

# Largest accepted image area (width × height, and for an animated GIF the frames together), read from the file's
# header before decoding.
# MY_MEDIA_MAX_IMAGE_PIXELS=33177600

# How long an upload may stay unattached to any post or profile before the hourly cleanup deletes it, as a Go duration
# such as `24h`.
# MY_MEDIA_UNATTACHED_RETENTION=24h

# How long the files of an image's replaced version stay after a newer version replaces them, as a Go duration such as
# `720h`.
# MY_MEDIA_REPLACED_RETENTION=720h

# Largest accepted video or audio upload in bytes.
# MY_MEDIA_MAX_AV_BYTES=104857600

# Longest accepted video upload, as a Go duration such as `5m`.
# MY_MEDIA_MAX_VIDEO_DURATION=5m

# Longest accepted audio upload, as a Go duration such as `10m`.
# MY_MEDIA_MAX_AUDIO_DURATION=10m

# Largest image in bytes that a local custom emoji may be registered with; the image must also be a PNG, a GIF, or a
# WebP of at most 1,024 pixels on a side.
# MY_CUSTOM_EMOJI_MAX_BYTES=262144

# Largest image in bytes of a remote custom emoji that the media proxy serves; the proxy answers 404 for a larger one,
# and for one that is not a PNG, a GIF, or a WebP.
# MY_REMOTE_CUSTOM_EMOJI_MAX_BYTES=1048576

# ------------------------------------------------------------------------------------------------------------------
# Key-value store
# ------------------------------------------------------------------------------------------------------------------

# Key-value store adapter for caches and rate limits. Values: db, memory, valkey.
# MY_KV=db

# Valkey server of the adapters that use one (`kv = valkey`, `stream =
# valkey`):`valkey://[user:password@]host[:port][/db]` (`redis://` is the same), `valkeys://` or `rediss://` for TLS,
# or `unix:///path/to/socket`. Required: when `kv = valkey` or `stream = valkey`. A secret.
# MY_VALKEY_URL=

# PEM file of the certificate authorities that the TLS certificate of `valkey_url` chains to, for a managed service
# with a private CA.
# MY_VALKEY_TLS_CA_FILE=

# Prefix of every key that this server writes to `valkey_url`, so that several instances or other applications can
# share the server.
# MY_VALKEY_KEY_PREFIX=my:

# ------------------------------------------------------------------------------------------------------------------
# Real-time updates
# ------------------------------------------------------------------------------------------------------------------

# Broker that carries the signals of the real-time updates (`GET /api/v1/streaming`) between processes. Values: hub,
# postgres, valkey, sns, pubsub.
# MY_STREAM=hub

# Connection string of the `LISTEN` connections of `stream = postgres`, in the format of `database_url`. Default:
# value of `database_url`. A secret.
# MY_STREAM_POSTGRES_URL=

# ARN of the Amazon SNS standard topic of `stream = sns`, which the deployment template creates. Required: when
# `stream = sns`.
# MY_STREAM_SNS_TOPIC_ARN=

# Start of the names of the per-process SQS queues of `stream = sns`, `{prefix}-{process id}-{n}`. Required: when
# `stream = sns`.
# MY_STREAM_SNS_QUEUE_PREFIX=

# Full name of the Google Cloud Pub/Sub topic of `stream = pubsub`, `projects/{project}/topics/{topic}`, which the
# deployment template creates. Required: when `stream = pubsub`.
# MY_STREAM_PUBSUB_TOPIC=

# Start of the IDs of the per-process subscriptions of `stream = pubsub`, `{prefix}-{process id}-{n}`. Required: when
# `stream = pubsub`.
# MY_STREAM_PUBSUB_SUBSCRIPTION_PREFIX=

# ------------------------------------------------------------------------------------------------------------------
# Encryption keys
# ------------------------------------------------------------------------------------------------------------------

# Key manager adapter that encrypts actor private keys. Values: local, gcpkms, awskms, plugin.
# MY_KEY_MANAGER=local

# MY_KEK is not set here: the file secrets/kek holds the key-encryption key (see the top of this file).

# Previous key-encryption keys, comma-separated, each in the format of `kek`. A secret.
# MY_KEK_PREVIOUS=

# Key of the KMS that encrypts the secrets when `key_manager` is `gcpkms` or `awskms`. Required: when `key_manager` is
# `gcpkms` or `awskms`.
# MY_KMS_KEY=

# Previous keys of the same KMS, comma-separated, each in the format of `kms_key`.
# MY_KMS_KEY_PREVIOUS=

# How long the server keeps a data-encryption key that the KMS or plugin decrypted, as a Go duration, so that a secret
# in use reaches it about once per this period and process.
# MY_KMS_DEK_CACHE_TTL=10m

# Most data-encryption keys that the cache of `kms_dek_cache_ttl` keeps, the least recently used going first.
# MY_KMS_DEK_CACHE_ENTRIES=1024

# ------------------------------------------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------------------------------------------

# Mailer adapter for verification emails. Values: none, smtp, ses, plugin.
# MY_MAIL=none

# Sender address of emails, as a bare address such as `noreply@social.example`. Required: when `mail` is not `none`.
# MY_MAIL_FROM=

# Host name of the SMTP server. Required: when `mail = smtp`.
# MY_MAIL_SMTP_HOST=

# TCP port of the SMTP server (submission).
# MY_MAIL_SMTP_PORT=587

# User name for SMTP AUTH PLAIN, sent only after STARTTLS.
# MY_MAIL_SMTP_USERNAME=

# Password for SMTP AUTH PLAIN. A secret.
# MY_MAIL_SMTP_PASSWORD=

# AWS region of the SES endpoint of `mail = ses`, such as `eu-west-1`.
# MY_MAIL_SES_REGION=

# Name of the SES configuration set that `mail = ses` applies to every message, for its event destinations such as the
# SNS topic of the bounces and complaints (docs/operations/email.md).
# MY_MAIL_SES_CONFIGURATION_SET=

# ARN of the SNS topic that SES publishes the bounces and complaints to, `arn:aws:sns:<region>:<account>:<topic>`,
# with the topic attribute `SignatureVersion` set to `2` (docs/operations/email.md).
# MY_MAIL_SES_SNS_TOPIC_ARN=

# ------------------------------------------------------------------------------------------------------------------
# Captcha
# ------------------------------------------------------------------------------------------------------------------

# CAPTCHA service that the sign-in and registration forms check. Values: none, turnstile, hcaptcha, recaptcha.
# MY_CAPTCHA=none

# Public site key of the `captcha` service, which the widget on the forms carries. Required: when `captcha` is not
# `none`.
# MY_CAPTCHA_SITE_KEY=

# Secret key of the `captcha` service, which the server sends with each token to the service's siteverify API.
# Required: when `captcha` is not `none`. A secret.
# MY_CAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------------------------------------------------------
# Web Push
# ------------------------------------------------------------------------------------------------------------------

# VAPID private key of the server's Web Push notifications (RFC 8292). A secret.
# MY_VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------------------------------------------
# Profile and outbound destinations
# ------------------------------------------------------------------------------------------------------------------

# Whether this is a production instance. Values: production, development.
# MY_PROFILE=production

# Lets outbound HTTP (federation, media, link previews) reach loopback, private, and other non-public addresses and
# host names, over plain `http` and on any port. Values: false, true.
# MY_HTTP_ALLOW_PRIVATE_NETWORKS=false

# Destinations on loopback or a private network that the instance's webhooks may reach, such as an automation tool on
# the same host or in the same VPC.
# MY_WEBHOOK_ALLOWED_DESTINATIONS=

# Destinations on loopback or a private network that the external sign-in providers may be on, such as an OpenID
# Connect provider in the same VPC.
# MY_LOGIN_PROVIDER_ALLOWED_DESTINATIONS=

# For development only.
# MY_PUSH_ALLOWED_DESTINATIONS=

# ------------------------------------------------------------------------------------------------------------------
# Relays
# ------------------------------------------------------------------------------------------------------------------

# How many activities each relay may bring in per hour.
# MY_RELAY_MAX_ACTIVITIES_PER_HOUR=1000

# ------------------------------------------------------------------------------------------------------------------
# Cost records
# ------------------------------------------------------------------------------------------------------------------

# Cloud providers whose usage charges are imported into the instance's costs every 24 hours, comma-separated.
# MY_BILLING_SOURCES=

# How many billed AWS Cost Explorer requests (one per page, $0.01 each) the imports of `billing_sources = aws` may
# make per UTC day, counting the scheduled imports, their retries, and the imports that an administrator starts.
# MY_BILLING_AWS_MAX_REQUESTS_PER_DAY=4

# How many billed AWS Cost Explorer requests the imports may make per UTC calendar month, the bound of the cost of the
# imports (the default is $1.20 a month.
# MY_BILLING_AWS_MAX_REQUESTS_PER_MONTH=120

# Cost Explorer metric that the imports of `billing_sources = aws` record. Values: NetUnblendedCost, UnblendedCost.
# MY_BILLING_AWS_METRIC=NetUnblendedCost

# Which costs of the AWS account the imports of `billing_sources = aws` take. Values: none, linked_account, tag.
# MY_BILLING_AWS_FILTER=none

# The activated cost allocation tag of `billing_aws_filter = tag`, `key=value` such as `app=my`. Required: when
# `billing_aws_filter = tag`.
# MY_BILLING_AWS_TAG=

# The 12-digit IDs of the member accounts of `billing_aws_filter = linked_account`, comma-separated. Required: when
# `billing_aws_filter = linked_account`.
# MY_BILLING_AWS_LINKED_ACCOUNTS=

# ARN of an IAM role that the imports of `billing_sources = aws` assume with the Google ID token of the instance's
# service account (`AssumeRoleWithWebIdentity`, audience.
# MY_BILLING_AWS_ROLE_ARN=

# How the imports of `billing_sources = gcp` read the Google Cloud usage charges. Values: bigquery, budget.
# MY_BILLING_GCP_METHOD=bigquery

# The table of the standard usage cost export of Cloud Billing to BigQuery, `project.dataset.table` such as
# `my-project.billing_export.gcp_billing_export_v1_012345_6789AB_CDEF01`. Required: when `billing_sources` includes
# `gcp` and `billing_gcp_method = bigquery`.
# MY_BILLING_GCP_TABLE=

# The Google Cloud project that runs the BigQuery queries of `billing_gcp_method = bigquery` and is billed for their
# bytes; the service account of the server needs `roles/bigquery.jobUser` on it.
# MY_BILLING_GCP_QUERY_PROJECT=

# Google Cloud project IDs, comma-separated, whose costs the imports of `billing_gcp_method = bigquery` take
# (`project.id` of the export).
# MY_BILLING_GCP_PROJECTS=

# A label `key=value`, such as `app=my`, whose resources' costs the imports of `billing_gcp_method = bigquery` take
# (`labels` of the export).
# MY_BILLING_GCP_LABEL=

# The `maximumBytesBilled` of each BigQuery query of `billing_gcp_method = bigquery`, in bytes.
# MY_BILLING_GCP_MAX_BYTES_BILLED=1073741824

# The pull subscription of the Pub/Sub topic of a monthly Cloud Billing budget that `billing_gcp_method = budget`
# reads, `projects/{project}/subscriptions/{subscription}`. Required: when `billing_sources` includes `gcp` and
# `billing_gcp_method = budget`.
# MY_BILLING_GCP_BUDGET_SUBSCRIPTION=

# ------------------------------------------------------------------------------------------------------------------
# Payments
# ------------------------------------------------------------------------------------------------------------------

# The payment provider of the supporters. Values: none, stripe, payjp.
# MY_PAYMENTS=none

# The API key of the Stripe account of `payments = stripe`. Required: when `payments = stripe`. A secret.
# MY_PAYMENTS_STRIPE_SECRET_KEY=

# The signing secret (`whsec_`) of the webhook endpoint `https://<domain>/payments/webhooks/stripe` that the operator
# registers on Stripe's dashboard, or of `stripe listen` for local tests. Required: when `payments = stripe`. A
# secret.
# MY_PAYMENTS_STRIPE_WEBHOOK_SECRET=

# The secret key (`sk_test_` / `sk_live_`) of the PAY.JP account of `payments = payjp`. Required: when `payments =
# payjp`. A secret.
# MY_PAYMENTS_PAYJP_SECRET_KEY=

# The public key (`pk_test_` / `pk_live_`) of the PAY.JP account of `payments = payjp`, of the mode of
# `payments_payjp_secret_key`, which the server's checkout and card pages give payjp.js. Required: when `payments =
# payjp`.
# MY_PAYMENTS_PAYJP_PUBLIC_KEY=

# The webhook token (`whook_`) of the PAY.JP account in the mode of `payments_payjp_secret_key`, which PAY.JP sends in
# `X-Payjp-Webhook-Token` to `https://<domain>/payments/webhooks/payjp`. Required: when `payments = payjp`. A secret.
# MY_PAYMENTS_PAYJP_WEBHOOK_TOKEN=

# How often the reconciliation with `payments` runs.
# MY_PAYMENTS_RECONCILE_INTERVAL=6h

# How many requests one reconciliation sends to `payments`, a page of a list counting as one.
# MY_PAYMENTS_RECONCILE_MAX_REQUESTS=1000

# ------------------------------------------------------------------------------------------------------------------
# Translation providers
# ------------------------------------------------------------------------------------------------------------------

# The base URL of the LibreTranslate server of the translation provider `libretranslate`, such as
# `https://libretranslate.com` or a server you run on a private address, such as `http://libretranslate:5000`; `http:`
# is accepted on any host.
# MY_TRANSLATOR_LIBRETRANSLATE_URL=

# The API key of the LibreTranslate server of `translator_libretranslate_url`, when the server requires one, as
# `libretranslate.com` does. A secret.
# MY_TRANSLATOR_LIBRETRANSLATE_API_KEY=

# The authentication key of DeepL's API, which makes DeepL a translation provider that `translation_providers` can
# enable as `deepl` ([translation](../operations/translation.md#deepl)). A secret.
# MY_TRANSLATOR_DEEPL_API_KEY=

# The `https:` URL of DeepL's API that the server calls, such as a proxy in front of it; `http:` is accepted for
# localhost only. Default: `https://api-free.deepl.com` for a key of the free plan, `https://api.deepl.com` otherwise.
# MY_TRANSLATOR_DEEPL_URL=

# The Google Cloud project that the translations of the provider `google`, Google Cloud Translation, are billed to;
# the Cloud Translation API must be enabled in it, and the service account of the server needs
# `roles/cloudtranslate.user` on it.
# MY_TRANSLATOR_GOOGLE_PROJECT=

# The location of the requests of the provider `google`. Default: `global`.
# MY_TRANSLATOR_GOOGLE_LOCATION=

# The AWS region of Amazon Translate, such as `us-east-1`.
# MY_TRANSLATOR_AWS_REGION=

# The search engine of the full-text search of statuses. Values: none, elasticsearch, opensearch, meilisearch.
# MY_SEARCH=none

# The URL of the REST API of the Elasticsearch cluster of `search = elasticsearch`, such as
# `https://search.internal.example:9200`, without credentials, query, or fragment; a path is kept, for a proxy that
# serves the API under one. Required: when `search = elasticsearch`.
# MY_SEARCH_ELASTICSEARCH_URL=

# The API key of `search = elasticsearch`, the `encoded` value that Elasticsearch returns when it creates the key,
# sent as `Authorization. A secret.
# MY_SEARCH_ELASTICSEARCH_API_KEY=

# The user of `search = elasticsearch` for basic authentication, with `search_elasticsearch_password`, when
# `search_elasticsearch_api_key` is not set.
# MY_SEARCH_ELASTICSEARCH_USERNAME=

# The password of `search_elasticsearch_username`. Required: when `search_elasticsearch_username` is set. A secret.
# MY_SEARCH_ELASTICSEARCH_PASSWORD=

# The name of the alias that the index of `search = elasticsearch` lives behind; the server names the index behind it
# from this name with a suffix, such as `my-statuses-v1`. Default: `my-statuses`.
# MY_SEARCH_ELASTICSEARCH_INDEX=

# JSON file of the settings of each index that the server creates for `search = elasticsearch`, one object such as
# `{"number_of_shards".
# MY_SEARCH_ELASTICSEARCH_INDEX_SETTINGS_FILE=

# PEM file of the certificate authorities that the TLS certificate of `search_elasticsearch_url` chains to, such as
# the `http_ca.crt` that Elasticsearch generates when it starts with security on.
# MY_SEARCH_ELASTICSEARCH_CA_FILE=

# The URL of the REST API of the OpenSearch cluster of `search = opensearch`, such as
# `https://search.example.org:9200`, with no credentials, query, or fragment; a path is kept, for a cluster behind a
# reverse proxy. Required: when `search = opensearch`.
# MY_SEARCH_OPENSEARCH_URL=

# The name of the alias of the index of `search = opensearch`. Default: `my-statuses`.
# MY_SEARCH_OPENSEARCH_INDEX=

# The path of a JSON file whose object the server uses as the `settings` of every index of `search = opensearch` that
# it creates.
# MY_SEARCH_OPENSEARCH_INDEX_SETTINGS_FILE=

# The user of the HTTP Basic authentication of `search = opensearch`, such as a user of the OpenSearch security plugin
# or the master user of an Amazon OpenSearch Service domain with fine-grained access control.
# MY_SEARCH_OPENSEARCH_USERNAME=

# The password of `search_opensearch_username`. Required: when `search_opensearch_username` is set. A secret.
# MY_SEARCH_OPENSEARCH_PASSWORD=

# Whether the server signs the requests of `search = opensearch` with AWS Signature Version 4, as a domain of Amazon
# OpenSearch Service with an IAM access policy needs. Values: off, es. Default: `off`.
# MY_SEARCH_OPENSEARCH_AWS_SIGNING=

# The AWS region of the domain of `search_opensearch_aws_signing = es`, such as `us-east-1`. Default: the region of
# the AWS SDK's default chain (`AWS_REGION`).
# MY_SEARCH_OPENSEARCH_AWS_REGION=

# The base URL of the Meilisearch server of `search = meilisearch`, such as `https://meilisearch.example.org` or
# `http://meilisearch:7700` on a private network. Required: when `search = meilisearch`.
# MY_SEARCH_MEILISEARCH_URL=

# The master key of the Meilisearch server, or an API key with the actions `search`, `documents.add`, `documents.get`,
# `documents.delete`, `indexes.create`, `indexes.get`, `indexes.delete`, `settings.update`, and `tasks.get` on
# `search_meilisearch_index`. A secret.
# MY_SEARCH_MEILISEARCH_API_KEY=

# The uid of the Meilisearch index of the posts, which the server creates when it does not exist. Default:
# `my_statuses`.
# MY_SEARCH_MEILISEARCH_INDEX=

# The path of a JSON object of Meilisearch index settings, to tune the engine.
# MY_SEARCH_MEILISEARCH_SETTINGS_FILE=

# ------------------------------------------------------------------------------------------------------------------
# Voice chat
# ------------------------------------------------------------------------------------------------------------------

# How the voice chat rooms connect their participants. Values: off, p2p, livekit, sora.
# MY_VOICE=off

# How many people a room of `voice = p2p` holds, from 2 to 50; one more is refused.
# MY_VOICE_P2P_MAX_PARTICIPANTS=10

# How many people a room of `voice = livekit` or `voice = sora` holds; one more is refused.
# MY_VOICE_SFU_MAX_PARTICIPANTS=10

# The longest a room stays open, a Go duration such as `4h`; a room that reaches it is ended.
# MY_VOICE_MAX_ROOM_DURATION=4h

# How many rooms may be open on the server at the same time; opening one more is refused.
# MY_VOICE_MAX_OPEN_ROOMS=10

# The STUN servers with which the browsers of `voice = p2p` find their public addresses, comma-separated `stun:` or
# `stuns:` URLs such as `stun:stun.example.org:3478`.
# MY_VOICE_STUN_URLS=

# The TURN server that relays the audio of `voice = p2p` between browsers that cannot reach each other directly, with
# short-lived credentials for each participant. Values: none, coturn, cloudflare.
# MY_VOICE_TURN=none

# The URLs of the coturn server of `voice_turn = coturn`, comma-separated `turn:` or `turns:` URLs such as
# `turn:turn.example.org:3478?transport=udp, turns:turn.example.org:5349`. Required: when `voice = p2p` and
# `voice_turn = coturn`.
# MY_VOICE_TURN_COTURN_URLS=

# The `static-auth-secret` of the coturn server of `voice_turn = coturn`, which signs the short-lived credentials that
# the server gives the participants. Required: when `voice = p2p` and `voice_turn = coturn`. A secret.
# MY_VOICE_TURN_COTURN_SECRET=

# The ID of the TURN key of `voice_turn = cloudflare`, from Cloudflare's dashboard. Required: when `voice = p2p` and
# `voice_turn = cloudflare`.
# MY_VOICE_TURN_CLOUDFLARE_KEY_ID=

# The API token of the TURN key of `voice_turn = cloudflare`, with which the server asks Cloudflare for the
# credentials of each participant. Required: when `voice = p2p` and `voice_turn = cloudflare`. A secret.
# MY_VOICE_TURN_CLOUDFLARE_API_TOKEN=

# How long the TURN credentials of a participant stay valid, a Go duration; the web client asks for new ones before
# they expire.
# MY_VOICE_TURN_CREDENTIAL_TTL=6h

# Which connections the browsers of `voice = p2p` make. Values: all, relay.
# MY_VOICE_ICE_TRANSPORT_POLICY=all

# The `wss:` URL of the LiveKit server of `voice = livekit` that the browsers connect to, such as
# `wss://livekit.example.org`; `ws:` is accepted for localhost only. Required: when `voice = livekit`.
# MY_VOICE_LIVEKIT_URL=

# The `https:` URL of the API of the LiveKit server of `voice = livekit` that the server calls, when it differs from
# `voice_livekit_url`; `http:` is accepted for localhost only. Default: `voice_livekit_url` with `https:` (`http:` for
# `ws:`).
# MY_VOICE_LIVEKIT_API_URL=

# The API key of the LiveKit server of `voice = livekit`. Required: when `voice = livekit`.
# MY_VOICE_LIVEKIT_API_KEY=

# The API secret of `voice_livekit_api_key`, which signs the access tokens of the participants and verifies the
# webhooks of the LiveKit server. Required: when `voice = livekit`. A secret.
# MY_VOICE_LIVEKIT_API_SECRET=

# Where the Sora server of `voice = sora` runs. Values: self_hosted, cloud. Required: when `voice = sora`.
# MY_VOICE_SORA_MODE=

# The signaling URLs of the Sora server of `voice = sora` that the browsers connect to, comma-separated `wss:` URLs;
# `ws:` is accepted for localhost only. Required: when `voice = sora`.
# MY_VOICE_SORA_SIGNALING_URLS=

# The `https:` URL of the reverse proxy in front of the API of the self-hosted Sora server, which the server calls;
# the API of Sora itself has no authentication and must not be reachable from outside. Required: when `voice = sora`
# and `voice_sora_mode = self_hosted`.
# MY_VOICE_SORA_API_URL=

# The name of the header with which the reverse proxy of `voice_sora_api_url` authenticates the server, such as
# `Authorization`; set it together with `voice_sora_api_header_value`.
# MY_VOICE_SORA_API_HEADER_NAME=

# The value of the header `voice_sora_api_header_name`, such as `Basic dXNlcjpwYXNz`. Required: when `voice = sora`
# and `voice_sora_api_header_name` is set. A secret.
# MY_VOICE_SORA_API_HEADER_VALUE=

# The Basic authentication user name that the self-hosted Sora server sends with its webhooks. Required: when `voice =
# sora` and `voice_sora_mode = self_hosted`.
# MY_VOICE_SORA_WEBHOOK_USERNAME=

# The Basic authentication password of `voice_sora_webhook_username`. Required: when `voice = sora` and
# `voice_sora_mode = self_hosted`. A secret.
# MY_VOICE_SORA_WEBHOOK_PASSWORD=

# The project ID of Sora Cloud of `voice_sora_mode = cloud`. Required: when `voice = sora` and `voice_sora_mode =
# cloud`.
# MY_VOICE_SORA_CLOUD_PROJECT_ID=

# The API key of the Sora Cloud project, which signs the access tokens of the participants, authenticates the calls of
# its API, and verifies the signatures of its webhooks. Required: when `voice = sora` and `voice_sora_mode = cloud`. A
# secret.
# MY_VOICE_SORA_CLOUD_API_KEY=

# The secret that signs the values with which the participants of `voice = sora` join a room, which the Sora server
# sends back for the server to authorize each connection. Required: when `voice = sora`. A secret.
# MY_VOICE_SORA_JOIN_SECRET=

# ------------------------------------------------------------------------------------------------------------------
# Retention
# ------------------------------------------------------------------------------------------------------------------

# How long a dead job (a job that failed for good or used up its attempts) is kept after it failed, for an operator to
# inspect and requeue it; the hourly purge then deletes it.
# MY_DEAD_JOB_RETENTION=720h

# How long the record of a job's run that did not succeed (a retry, or the run that made it a dead job) is kept after
# the run, for the queue dashboard of the admin screen; the hourly purge then deletes it.
# MY_JOB_ATTEMPT_RETENTION=720h

# How long a dynamically registered OAuth client (RFC 7591, `POST /oauth/register`) may wait for the exchange of its
# first authorization code.
# MY_DYNAMIC_CLIENT_UNREDEEMED_RETENTION=24h

# How long a dynamically registered OAuth client without a usable token may go unused before the hourly clean-up
# deletes it.
# MY_DYNAMIC_CLIENT_IDLE_RETENTION=2160h

# ------------------------------------------------------------------------------------------------------------------
# Metrics, traces, and error reports
# ------------------------------------------------------------------------------------------------------------------

# Where the service metrics go. Values: none, prometheus, otlp, emf.
# MY_METRICS_EXPORTER=none

# TCP address, as `host:port`, of the listener that serves `GET /metrics` when `metrics_exporter = prometheus`, apart
# from `listen`.
# MY_METRICS_LISTEN=127.0.0.1:9464

# CloudWatch namespace of the metrics of `metrics_exporter = emf`.
# MY_METRICS_EMF_NAMESPACE=my

# Labels that become CloudWatch dimensions with `metrics_exporter = emf`, comma-separated, such as `my.surface,
# my.role`; the other labels stay fields of the log line.
# MY_METRICS_EMF_DIMENSIONS=

# Where the distributed traces go. Values: none, otlp.
# MY_TRACES_EXPORTER=none

# Share of the traces recorded with `traces_exporter = otlp`, from `0` to `1`, among the requests and jobs without a
# sampled parent.
# MY_TRACES_SAMPLE_RATIO=0.01

# When the spans of `traces_exporter = otlp` are sent. Values: batch, unit.
# MY_TRACES_FLUSH=batch

# Where the error reports also go. Values: none, sentry, otlp.
# MY_ERRORS_EXPORTER=none

# DSN of the project that receives the error reports of `errors_exporter = sentry`, as the service shows it, such as
# `https://<key>@o0.ingest.sentry.io/<project>`. Required: when `errors_exporter` is `sentry`. A secret.
# MY_ERRORS_SENTRY_DSN=

# Name of the environment that every error report carries, such as `staging`, to tell the reports of several
# deployments apart. Default: the value of `profile`.
# MY_ERRORS_ENVIRONMENT=

# ------------------------------------------------------------------------------------------------------------------
# Plugins
# ------------------------------------------------------------------------------------------------------------------

# Where the `translator` plugin listens.
# MY_PLUGIN_TRANSLATOR_ADDRESS=

# What the server sends to the `translator` plugin; it must be what the plugin accepts. Values: json, proto, grpc.
# Default: `json`.
# MY_PLUGIN_TRANSLATOR_PROTOCOL=

# Bearer token that the server sends to the `translator` plugin, over `https://` or `unix://` only. A secret.
# MY_PLUGIN_TRANSLATOR_TOKEN=

# File of the CA that verifies the `translator` plugin at an `https://` address. Default: the system's roots.
# MY_PLUGIN_TRANSLATOR_TLS_CA_FILE=

# File of the client certificate that the server shows the `translator` plugin at an `https://` address (mTLS), with
# its key file.
# MY_PLUGIN_TRANSLATOR_TLS_CERT_FILE=

# File of the key of that client certificate of the `translator` plugin.
# MY_PLUGIN_TRANSLATOR_TLS_KEY_FILE=

# Deadline of one call of the `translator` plugin, less than `30s`. Default: `10s`.
# MY_PLUGIN_TRANSLATOR_TIMEOUT=

# The name that readers see next to a translation by the `translator` plugin and that the admin screen lists, such as
# the service behind your plugin, at most 100 characters. Required: when `plugin_translator_address` is set.
# MY_PLUGIN_TRANSLATOR_NAME=

# Where the `billing` plugin listens. Required: when `billing_sources` includes `plugin`.
# MY_PLUGIN_BILLING_ADDRESS=

# What the server sends to the `billing` plugin; it must be what the plugin accepts. Values: json, proto, grpc.
# Default: `json`.
# MY_PLUGIN_BILLING_PROTOCOL=

# Bearer token that the server sends to the `billing` plugin, over `https://` or `unix://` only. A secret.
# MY_PLUGIN_BILLING_TOKEN=

# File of the CA that verifies the `billing` plugin at an `https://` address. Default: the system's roots.
# MY_PLUGIN_BILLING_TLS_CA_FILE=

# File of the client certificate that the server shows the `billing` plugin at an `https://` address (mTLS), with its
# key file.
# MY_PLUGIN_BILLING_TLS_CERT_FILE=

# File of the key of that client certificate of the `billing` plugin.
# MY_PLUGIN_BILLING_TLS_KEY_FILE=

# Deadline of one call of the `billing` plugin, less than `5m0s`. Default: `2m0s`.
# MY_PLUGIN_BILLING_TIMEOUT=

# IANA time zone that cuts the billing months of `billing_sources = plugin`, such as `UTC` or `Asia/Tokyo`. Required:
# when `billing_sources` includes `plugin`.
# MY_PLUGIN_BILLING_LOCATION=

# The provider's name that the totals, the costs page, and the audit log show for `billing_sources = plugin`, such as
# `Hetzner`, at most 100 characters. Required: when `billing_sources` includes `plugin`.
# MY_PLUGIN_BILLING_PROVIDER=

# Where the `mailer` plugin listens. Required: when `mail = plugin`.
# MY_PLUGIN_MAILER_ADDRESS=

# What the server sends to the `mailer` plugin; it must be what the plugin accepts. Values: json, proto, grpc.
# Default: `json`.
