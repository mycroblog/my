---
// SPDX-License-Identifier: AGPL-3.0-only
// Starlight's Footer with the plain-text forms of this version of the site for LLMs (src/llms-txt.ts).
import Default from "@astrojs/starlight/components/Footer.astro";
import { base } from "../published";
---

<Default />
<p class="docs-llms" data-pagefind-ignore>
  For LLMs and coding agents: <a href={`${base}llms.txt`}>llms.txt</a>,
  <a href={`${base}llms-full.txt`}>llms-full.txt</a>, <a href={`${base}llms-small.txt`}>llms-small.txt</a>
</p>

<style>
  .docs-llms {
    margin-block-start: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
