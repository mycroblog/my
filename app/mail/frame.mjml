<!--
  The one layout of every HTML email (ADR-0086 §2). src/frame.ts compiles it into the Go html/template
  internal/app/kernel/mail_frame.gen.html, which kernel.MailComposer executes; the {{...}} actions are Go's and
  name the fields of the composer's data. %color-NAME:SCHEME% is the default of the design token
  (internal/domain/instance/theme_tokens.gen.go). No external font or image is loaded: the system fonts
  are listed, and frame.ts compiles with `fonts: {}`.
-->
<mjml lang="{{.Lang}}" dir="{{.Dir}}">
  <mj-head>
    <mj-title>{{.Subject}}</mj-title>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', 'Noto Sans CJK JP', 'Hiragino Sans', 'Noto Sans Arabic', Tahoma, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="%color-fg:light%" padding="0 0 16px 0" />
      <mj-button background-color="%color-accent:light%" color="%color-accent-fg:light%" font-size="16px" font-weight="600" border-radius="8px" inner-padding="12px 24px" padding="8px 0 24px 0" align="center" />
      <mj-class name="muted" color="%color-fg-muted:light%" font-size="13px" />
      <mj-divider border-color="%color-border-strong:light%" border-width="1px" padding="8px 0 16px 0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      @media (prefers-color-scheme: dark) {
        body, .mail-body { background-color: %color-surface:dark% !important; }
        .mail-card, .mail-card > table, .mail-card > table > tbody > tr > td { background-color: %color-surface-raised:dark% !important; }
        .mail-text div { color: %color-fg:dark% !important; }
        .mail-muted div { color: %color-fg-muted:dark% !important; }
        .mail-button td, .mail-button a { background-color: %color-accent:dark% !important; color: %color-accent-fg:dark% !important; }
        .mail-link { color: %color-accent:dark% !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="%color-surface:light%" css-class="mail-body">
    <mj-section padding="24px 16px">
      <mj-column background-color="%color-surface-raised:light%" padding="24px" border-radius="12px" css-class="mail-card">
        <mj-raw>{{range .Paragraphs}}</mj-raw>
        <mj-text css-class="mail-text">{{.}}</mj-text>
        <mj-raw>{{end}}</mj-raw>
        <mj-raw>{{with .Action}}{{if .URL}}</mj-raw>
        <mj-button href="{{.URL}}" css-class="mail-button">{{.Label}}</mj-button>
        <mj-text mj-class="muted" css-class="mail-muted"><a href="{{.URL}}" class="mail-link" style="color: %color-accent:light%; word-break: break-all;">{{.URL}}</a></mj-text>
        <mj-raw>{{else}}</mj-raw>
        <mj-text css-class="mail-text">{{.Label}}</mj-text>
        <mj-text mj-class="muted" css-class="mail-muted">{{.Text}}</mj-text>
        <mj-raw>{{end}}{{end}}</mj-raw>
        <mj-divider />
        <mj-text mj-class="muted" css-class="mail-muted" padding="0 0 4px 0">{{.Site.Name}}</mj-text>
        <mj-raw>{{if .SiteURL}}</mj-raw>
        <mj-text mj-class="muted" css-class="mail-muted" padding="0 0 4px 0"><a href="{{.SiteURL}}" class="mail-link" style="color: %color-accent:light%;">{{.SiteURL}}</a></mj-text>
        <mj-raw>{{end}}</mj-raw>
        <mj-raw>{{with .Contact}}</mj-raw>
        <mj-text mj-class="muted" css-class="mail-muted" padding="0 0 4px 0">{{.}}</mj-text>
        <mj-raw>{{end}}</mj-raw>
        <mj-text mj-class="muted" css-class="mail-muted" padding="12px 0 0 0">{{.Reason}}</mj-text>
        <mj-raw>{{with .Unsubscribe}}</mj-raw>
        <mj-text mj-class="muted" css-class="mail-muted" padding="4px 0 0 0">{{.Before}}{{with .URL}}<a href="{{.}}" class="mail-link" style="color: %color-accent:light%; word-break: break-all;">{{.}}</a>{{end}}{{.After}}</mj-text>
        <mj-raw>{{end}}</mj-raw>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
