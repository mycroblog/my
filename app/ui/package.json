{
  "name": "@my/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./emoji.css": "./src/emoji.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.app.tsbuildinfo && tsc -p tsconfig.node.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.node.tsbuildinfo && tsc -p scripts/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/scripts.tsbuildinfo",
    "check-tokens": "bun run scripts/check-tokens.ts src/storybook.css ../web/src/index.css ../web/src/server-pages.css",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.22",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "dom-accessibility-api": "0.7.1",
    "jsdom": "30.1.3",
    "oxc-transform-react": "0.153.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.5"
  }
}
