          {
            "eventModules": [
              "fire-event"
            ]
          }
        ],
        "testing-library/no-await-sync-queries": "error",
        "testing-library/no-container": "error",
        "testing-library/no-debugging-utils": "warn",
        "testing-library/no-dom-import": [
          "error",
          "react"
        ],
        "testing-library/no-global-regexp-flag-in-query": "error",
        "testing-library/no-manual-cleanup": "error",
        "testing-library/no-node-access": "error",
        "testing-library/no-promise-in-fire-event": "error",
        "testing-library/no-render-in-lifecycle": "error",
        "testing-library/no-unnecessary-act": "error",
        "testing-library/no-wait-for-multiple-assertions": "error",
        "testing-library/no-wait-for-side-effects": "error",
        "testing-library/no-wait-for-snapshot": "error",
        "testing-library/prefer-find-by": "error",
        "testing-library/prefer-presence-queries": "error",
        "testing-library/prefer-query-by-disappearance": "error",
        "testing-library/prefer-screen-queries": "error",
        "testing-library/render-result-naming-convention": "error",
        "testing-library/prefer-user-event": "error",
        "testing-library/no-test-id-queries": "error",
        "restrict/test": [
          "error",
          {
            "selector": "CallExpression[callee.object.name='vi'][callee.property.name=/^(mock|doMock)$/][arguments.0.value=/(^|\\/)api(\\/|$)|^openapi-(fetch|react-query)$/]",
            "message": "Do not mock API modules; mock the network with MSW (web-client/README.md T3)."
          },
          {
            "selector": "CallExpression[callee.object.name='vi'][callee.property.name=/^(mock|doMock)$/][arguments.0.source.value=/(^|\\/)api(\\/|$)|^openapi-(fetch|react-query)$/]",
            "message": "Do not mock API modules; mock the network with MSW (web-client/README.md T3)."
          },
          {
            "selector": "CallExpression[callee.object.name='vi'][callee.property.name=/^(spyOn|stubGlobal)$/] > Literal.arguments[value='fetch']",
            "message": "Do not mock fetch; mock the network with MSW (web-client/README.md T3)."
          },
          {
            "selector": "AssignmentExpression > MemberExpression.left[property.name='fetch']",
            "message": "Do not replace fetch; mock the network with MSW (web-client/README.md T3)."
          },
          {
            "selector": "CallExpression[callee.object.name='vi'][callee.property.name='waitFor']",
            "message": "Wait with findBy or Testing Library's waitFor, which use the timeout of the test setup (web-client/README.md T7)."
          }
        ],
        "restrict/svg": "off",
