{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["oxlint/*.test.js"],
      "project": ["oxlint/**/*.js"],
      "tailwind": false
    },
    "ui": {
      "entry": ["src/**/*.stories.tsx", "src/storybook.css"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts", "scripts/**/*.ts", ".storybook/**/*.{ts,tsx}", "*.config.ts"]
    },
    "web": {
      "entry": ["e2e/server.ts", "demo/seed.ts", "l4/run.ts", "l4/issues.ts", "l4/**/*.test.ts", "scripts/*.ts", "src/routeTree.gen.ts", "sw/**/*.test.ts", "vite-plugins/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "sw/**/*.ts", "scripts/**/*.ts", "vite-plugins/**/*.ts", "e2e/**/*.ts", "l4/**/*.ts", "demo/**/*.ts", "*.config.ts"]
    },
    "mail": {
      "project": ["src/**/*.ts"]
    },
    "../pkg/mykit/ts": {
      "entry": ["src/**/*.test.ts", "examples/*.ts"],
      "project": ["src/**/*.ts", "examples/*.ts"],
      "ignoreDependencies": ["openapi-typescript"]
    },
    "../pkg/mybot/ts": {
      "entry": ["src/**/*.test.ts", "examples/*/main.ts", "examples/**/*.test.ts"],
      "project": ["src/**/*.ts", "examples/**/*.ts"],
      "ignore": ["test/runtimes.mjs"]
    }
  }
}
