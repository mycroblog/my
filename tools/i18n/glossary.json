      "use": "se connecter / connexion",
      "avoid": ["(?<![\\p{L}/_-])[Ll]ogin(?![\\p{L}_])", "(?<![\\p{L}/_-])[Ss]ign[ -]in(?![\\p{L}_])", "(?<![\\p{L}/_-])[Ss]’identifier(?![\\p{L}_])"],
      "note": "Starting a session. \"Login provider\", the name of the admin feature, is fournisseur de connexion."
    },
    {
      "use": "se déconnecter / déconnexion",
      "avoid": ["(?<![\\p{L}/_-])[Ll]ogout(?![\\p{L}_])"],
      "note": "Ending a session."
    },
    {
      "use": "abonné",
      "avoid": ["(?<![\\p{L}/_-])[Ff]ollowers?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Ss]uiveu(?:r|rs|se|ses)(?![\\p{L}_])"],
      "note": "Following an account is suivre; a follower is an abonné, the accounts a user follows are abonnements."
    },
    {
      "use": "mettre en sourdine",
      "avoid": ["(?<![\\p{L}/_-])[Mm]uter(?![\\p{L}_])", "(?<![\\p{L}/_-])[Mm]uté", "(?<![\\p{L}/_-])[Mm]ute(?![\\p{L}_])"],
      "note": "Muting an account or a word (en sourdine). Masquer is the Hide action."
    },
    {
      "use": "signaler / signalement",
      "avoid": ["(?<![\\p{L}/_-])[Rr]eporter(?![\\p{L}_])", "(?<![\\p{L}/_-])[Rr]eports?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Dd]énonc"],
      "note": "Reporting an account or a post to the moderators."
    },
    {
      "use": "avertissement de contenu",
      "avoid": ["(?<![\\p{L}/_-])[Aa]lerte de contenu(?![\\p{L}_])", "(?<![\\p{L}/_-])[Cc]ontent warning(?![\\p{L}_])"],
      "note": "A content warning (CW)."
    },
    {
      "use": "bannir / bannissement",
      "avoid": ["(?<![\\p{L}/_-])[Bb]an(?![\\p{L}_])"],
      "note": "Banning an account: the moderation action that removes it from the server. Suspending is suspendre; limiting is limiter."
    },
    {
      "use": "paramètres",
      "avoid": ["(?<![\\p{L}/_-])[Rr]églages(?![\\p{L}_])", "(?<![\\p{L}/_-])[Ss]ettings(?![\\p{L}_])"],
      "note": "The settings of an account or an instance."
    },
    {
      "use": "e-mail",
      "avoid": ["(?<![\\p{L}/_-])[Cc]ourriels?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Ee]mails?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Mm]ails?(?![\\p{L}_.])"],
      "note": "An email, and adresse e-mail."
    },
    {
      "use": "soutien",
      "avoid": ["(?<![\\p{L}/_-])[Ss]upporters?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Ss]ponsors?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Mm]écènes?(?![\\p{L}_])"],
      "note": "A supporter who pays for the instance; a supporter plan is a formule de soutien (never abonnement, which is following)."
    },
    {
      "use": "mobile",
      "avoid": ["(?<![\\p{L}/_-])[Tt]éléphones?(?![\\p{L}_])", "(?<![\\p{L}/_-])[Pp]ortables?(?![\\p{L}_])"],
      "note": "A narrow screen where the bottom tab bar is the navigation (\"phone\" in en)."
    },
    {
      "use": "’",
      "avoid": ["\\p{L}'\\p{L}"],
      "note": "The French apostrophe is ’ (U+2019), never the ASCII ' (which ICU MessageFormat may also read as a quote)."
    }
  ]
}
