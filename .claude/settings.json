{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/task.sh check)",
      "Bash(scripts/task.sh docs:lint)",
      "Bash(scripts/task.sh docs:adr-numbers)",
      "Bash(scripts/task.sh docs:adr-new *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge --auto *)",
      "Bash(gh pr merge * --auto*)",
      "Bash(scripts/agentkit.sh *)",
      "Bash(bin/agentkit *)",
      "Bash(scripts/task.sh agentkit:build)",
      "Bash(scripts/task.sh agentkit:check)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge --admin *)",
      "Bash(gh pr merge * --admin*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agentkit-hook.sh session-start",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agentkit-hook.sh pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agentkit-hook.sh post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
