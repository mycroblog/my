---
// SPDX-License-Identifier: AGPL-3.0-only
// A screenshot of the web app in the site's theme: the light and the dark image of src/assets/screenshots/ (taken by
// `scripts/task.sh docs:screenshots`), each hidden in the other theme by Starlight's utility classes. The images are
// served as they were taken, already WebP, without another encoding.
import type { ImageMetadata } from "astro";

interface Props {
  /** The name of the screenshot: src/assets/screenshots/<name>-light.webp and <name>-dark.webp. */
  name: string;
  /** What the screenshot shows, for people who cannot see it. */
  alt: string;
  /** The caption under the screenshot, if any. */
  caption?: string;
  /** Whether the image is the first thing on the page, loaded at once rather than when scrolled to. */
  eager?: boolean;
}

const { name, alt, caption, eager = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.webp", { eager: true });

function image(theme: "light" | "dark"): ImageMetadata {
  const found = images[`../assets/screenshots/${name}-${theme}.webp`]?.default;
  if (found === undefined) {
    throw new Error(`no screenshot ${name}-${theme}.webp in src/assets/screenshots/`);
  }
  return found;
}

const light = image("light");
const dark = image("dark");
const loading = eager ? "eager" : "lazy";
---

<figure class="screenshot not-content">
  <img
    class="dark:sl-hidden"
    src={light.src}
    width={light.width}
    height={light.height}
    alt={alt}
    loading={loading}
    decoding="async"
  />
  <img
    class="light:sl-hidden"
    src={dark.src}
    width={dark.width}
    height={dark.height}
    alt={alt}
    loading={loading}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin: 0;
  }
  /* No `display` here: Starlight's light:sl-hidden and dark:sl-hidden hide the image of the other theme with it. */
  .screenshot img {
    inline-size: 100%;
    block-size: auto;
    vertical-align: middle;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  .screenshot figcaption {
    margin-block-start: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
