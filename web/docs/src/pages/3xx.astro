---
// SPDX-License-Identifier: AGPL-3.0-only
// The page a static build writes at the old path of a renamed page (the redirects of astro.config.ts), in place of
// Astro's built-in one, so that it has the head every page of the site has (scripts/docs-site.sh check): a description,
// Open Graph tags, the canonical link of the page it leads to, and noindex where the version is not indexed. Astro also
// writes it as 3xx.html, with no redirect: that copy leads to the landing page.
import { base, site } from "../published";
import { indexedVersion } from "../versions";

const { to = base, delay = 0 } = Astro.props as { to?: string; delay?: number };
const target = new URL(to, site).href;
const title = "This page has moved";
const description = `This page has moved to ${target}.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`${delay};url=${to}`} />
    {!indexedVersion() && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={target} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={target} />
  </head>
  <body>
    <a href={to}>{description}</a>
  </body>
</html>
