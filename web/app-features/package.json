{
  "name": "@my/app-features",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun --bun tsc -p .",
    "test": "bun test --conditions=@mycroblog/source --path-ignore-patterns '**/*.{dom,jsdom}.test.tsx' && bun run test:dom && bun run test:jsdom",
    "test:dom": "bun test --conditions=@mycroblog/source --preload @my/devtools/happy-dom --pass-with-no-tests .dom.test.",
    "test:jsdom": "bun test --conditions=@mycroblog/source --preload @my/devtools/jsdom --pass-with-no-tests .jsdom.test."
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@my/app-components": "workspace:*",
    "@my/app-data": "workspace:*",
    "@my/design-system": "workspace:*",
    "@my/platform": "workspace:*",
    "lexical": "0.53.0"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@my/devtools": "workspace:*",
    "@my/e2e": "workspace:*",
    "@mycroblog/mykit": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
