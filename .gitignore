# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets
.env*
# The KEK of the Compose deployment.
/deploy/docker/secrets/

# Dependencies & build output
node_modules/
dist/
build/
# The build that internal/interface/web embeds (scripts/task.sh web:build); only the placeholder is committed.
!/internal/interface/web/dist/
/internal/interface/web/dist/*
!/internal/interface/web/dist/.gitkeep
bin/
# What a bare `go` command writes in workspace mode: go.work exists for Dependabot alone, and no check reads this.
go.work.sum
# The binary that `go build ./cmd/my` writes to the repository root.
/my
coverage/
*.log

# Local data
*.sqlite
*.sqlite3
*.db
.wrangler/
# The default blob_fs_dir of a server run from the repository root.
/blobs/

# Claude Code local settings
.claude/settings.local.json

# The documents web/docs/scripts/import-docs.ts copies into the documentation site; only its landing page, the
# analytics notice and the release notes page are written there.
/web/docs/src/content/docs/*
!/web/docs/src/content/docs/index.mdx
!/web/docs/src/content/docs/analytics.mdx
!/web/docs/src/content/docs/releases.mdx
# Their Markdown forms (public/<slug>.md), served next to the pages.
/web/docs/public/operations/
/web/docs/public/reference/
/web/docs/public/guide/
/web/docs/public/developers/
/web/docs/public/plugins/
/web/docs/public/*.md
# The copy of api/openapi.yaml that the client API reference renders (web/docs/src/api-schemas.ts).
/web/docs/generated/


# The types and cache Astro generates for the documentation site (web/docs); its build goes to dist/.
/web/docs/.astro/

# Scratch space of local tools and agents (logs, temporary clones).
/.tmp/

# The catalogs of the web packages, compiled by @my/i18n (scripts/task.sh i18n:compile; ADR-0081).
/web/*/src/messages.gen.ts
# The route tree of web/app, generated by TanStack Router (scripts/task.sh web:routes; ADR-0081).
/web/app/src/routeTree.gen.ts

# go-task's checksums of the generators' inputs (ADR-0081).
/.task/

