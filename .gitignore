# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets
.env
.env.*
!.env.example

# Dependencies & build output
node_modules/
dist/
build/
# The web build that internal/interface/web embeds; only the placeholder is committed.
!/internal/interface/web/dist/
/internal/interface/web/dist/*
!/internal/interface/web/dist/.gitkeep
bin/
# The binary that `go build ./cmd/my` writes to the repository root.
/my
coverage/
*.log

# Local data
*.sqlite
*.sqlite3
*.db
.wrangler/
# The default blob_fs_dir of a server run from the repository root.
/blobs/

# Claude Code local settings
.claude/settings.local.json

# Playwright output (app/web)
test-results/
playwright-report/
blob-report/

# Storybook build and Vitest browser-mode attachments (app/ui)
storybook-static/
.vitest/

# Scratch space of local tools and agents (logs, temporary clones).
/.tmp/

# go-task's checksums of the generators' inputs (ADR-0080).
/.task/

# Generated files only the TypeScript clients read (ADR-0081): the tasks that read them generate them first
# (`scripts/task.sh generate` makes them all, for an editor). The generated files Go reads are committed.
/tools/i18n/src/runtime/messages.gen.ts
/app/web/src/routeTree.gen.ts
/app/ui/src/themeTokens.gen.ts
/locales/en-XA/client*/
/locales/ar-XB/client*/
