{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "web/docs": {
      "entry": ["scripts/*.ts", "src/route-middleware.ts", "src/routeData.ts", "src/indexing.ts", "src/api-sidebar.ts", "src/section-sidebar.ts", "src/**/*.test.ts", "worker/index.ts", "worker/**/*.test.ts"],
      "project": ["*.config.ts", "src/**/*.{ts,astro,mdx}", "scripts/**/*.ts", "worker/**/*.ts"],
      "ignoreDependencies": ["satteri", "starlight-openapi-sources"]
    },
    "web/devtools": {
      "entry": ["src/storybook-preview.ts", "src/manager.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "web/design-tokens": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "web/design-system": {
      "entry": ["src/theme.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "web/app-components": {
      "entry": ["src/**/*.test.tsx", "src/**/*.stories.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "web/app-data": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "web/platform": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "web/app-features": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "web/app": {
      "entry": ["src/routes/**/*.tsx", "src/**/*.test.{ts,tsx}", "src/**/*.stories.tsx", "vite-plugins/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "vite-plugins/**/*.ts"]
    },
    "web/storybook": {
      "entry": ["shot.ts"],
      "project": [".storybook/*.{ts,tsx}"]
    },
    "web/e2e": {
      "entry": ["src/seed/main.ts", "specs/**/*.ts"],
      "project": ["src/**/*.ts", "specs/**/*.ts"]
    },
    "web/i18n": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/i18n": {
      "entry": ["src/cli.ts", "src/licenses.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "pkg/mykit/ts": {
      "entry": ["src/**/*.test.ts", "examples/*.ts"],
      "project": ["src/**/*.ts", "examples/*.ts"],
      "ignoreDependencies": ["openapi-typescript"]
    },
    "pkg/mybot/ts": {
      "entry": ["src/**/*.test.ts", "examples/*/main.ts", "examples/**/*.test.ts"],
      "project": ["src/**/*.ts", "examples/**/*.ts"]
    }
  }
}
