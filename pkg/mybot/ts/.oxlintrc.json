// Oxlint for @mycroblog/mybot (`scripts/task.sh mykit:mybot-ts-lint`): the rules of the client workspace
// (app/.oxlintrc.json, ADR-0049), whose overrides for app/ui and app/web match no file here, and the restriction of
// ADR-0094 §1: the library runs on any runtime with fetch and web streams, so it imports no Node.js built-in module
// statically. FileStore loads node:fs/promises with a dynamic import of a module name in a variable.
{
  "$schema": "../../../app/node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../app/.oxlintrc.json"],
  // test/runtimes.mjs is plain JavaScript that imports the build (dist/), outside every tsconfig, so the type-aware
  // rules see only `any` there; knip and its runs on Node.js and Deno cover it.
  "ignorePatterns": ["**/node_modules/", "dist/", "test/"],
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "import/no-nodejs-modules": "error"
      },
      "plugins": ["import"]
    },
    // The tests run on Bun and may read and write files.
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "import/no-nodejs-modules": "off"
      },
      "plugins": ["import"]
    }
  ]
}
